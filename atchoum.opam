# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Merlin-powered MCP server for Claude Code"
description:
  "A Claude Code plugin whose MCP server exposes Merlin queries as tools, so that Claude navigates and edits OCaml code through Merlin rather than through text-based tools such as grep or sed."
maintainer: ["Carine Morel <lyrm@github.com>"]
authors: ["Carine Morel"]
license: "MIT"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2"}
  "mcp-kit" {>= "0.2.0" & < "0.3"}
  "mcp-kit-eio" {>= "0.2.0" & < "0.3"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "alcotest" {with-test}
  "merlin" {with-test}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-ai-disclosure: "ai-generated"
x-ai-model: "claude-opus-5-5"
x-ai-provider: "Anthropic"
